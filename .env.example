# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-real-random-secret-key

DJANGO_DEBUG=False

# Comma-separated. Add your real domain once you have one, e.g.:
# DJANGO_ALLOWED_HOSTS=nodues.lnmiit.ac.in,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, must include scheme. Match whatever host/port you actually
# open this at, e.g. https://nodues.lnmiit.ac.in
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost

POSTGRES_DB=nodues
POSTGRES_USER=nodues
POSTGRES_PASSWORD=replace-with-a-real-password

# Host port nginx binds to (change if 80 is already taken on your machine).
HTTP_PORT=80

# Host port Postgres is published on, for local tools (psql, a DB client, or
# running `manage.py` directly against it outside the backend container).
# Change if 5432 is already taken on your machine (e.g. a local Postgres install).
POSTGRES_PORT=5432
